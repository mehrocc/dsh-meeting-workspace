{
  "name": "dsh-meeting-workspace-local",
  "version": "0.16.22",
  "description": "DSH 会议纪要工作台：会议采集、逐字稿、纪要、任务与原生会话辅助",
  "type": "module",
  "license": "MIT",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "src",
    "scripts",
    "tests/*.test.mjs",
    "cordis.patch.yml",
    "README.md",
    "native/darwin-arm64/DSHMeetingAudio.app",
    "native/Sources",
    "native/Info.plist",
    "native/entitlements.plist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-workbench-package.mjs",
    "build:native": "node scripts/build-native.mjs",
    "pack:local": "node scripts/pack-workbench.mjs",
    "prepare:speech-runtime": "node scripts/prepare-speech-runtime.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.6-alpha.1 <5.0.0-0",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.2 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "esbuild": "0.25.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mehrocc/dsh-meeting-workspace"
  }
}
